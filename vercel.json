{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "dino4vn.com",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dang-nhap",
      "destination": "/api/auth/steam"
    },
    {
      "source": "/api/auth/steam",
      "destination": "/api/auth/steam"
    },
    {
      "source": "/api/auth/steam/return",
      "destination": "/api/auth/return"
    },
    {
      "source": "/api/status.json",
      "destination": "/api/status"
    },
    {
      "source": "/api/bang-xep-hang.json",
      "destination": "/api/bxh"
    },
    {
      "source": "/api/player/garage/:action*",
      "destination": "/api/player/garage"
    },
    {
      "source": "/api/player/skin/quyen",
      "destination": "/api/player/skin?action=quyen"
    },
    {
      "source": "/api/player/skin/bang-mau",
      "destination": "/api/player/skin?action=bang-mau"
    },
    {
      "source": "/api/player/skin/kho",
      "destination": "/api/player/skin?action=kho"
    },
    {
      "source": "/api/player/skin/gradient",
      "destination": "/api/player/skin?action=gradient"
    },
    {
      "source": "/api/player/bo-mau",
      "destination": "/api/player/skin?action=bo-mau"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
